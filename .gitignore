# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/

# Tool output (regenerated per-game)
tools/disasm/output/
tools/func_id/output/
tools/recomp/output/
tools/abi_analysis/output/

# Game files (user provides their own), in either case: a disc copied on
# Windows can come out upper case
game_files/
*.[xX][bB][eE]
*.[iI][sS][oO]
*.[xX][iI][sS][oO]

# IDE
.vs/
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
.DS_Store

# Build
build/
bin/
*.obj
*.exe
tools/split/output/

# Built from launcher/icon/AppIcon.iconset by launcher/build_app.sh
launcher/AppIcon.icns

# Builds of the game (see port/CMakeLists.txt) and packaged apps
/build*/
*.app/
*.tar.gz
*.zip
*.ipa

# The generated code: derived from the game's executable, never committed
port/recomp/

# The game's files, saves, and logs, wherever a run puts them (either
# launcher's portable/ folder holds all three)
[Mm][Ee][Dd][Ii][Aa]/
[Uu][Dd][Aa][Tt][Aa]/
[Tt][Dd][Aa][Tt][Aa]/
portable/
Partition*.img
*.log
*.dump

# Backups and merge leftovers
*.bak*
*.orig

# Build notes kept beside the source (docs/build-and-test-reference.md)
BRINGUP.md
