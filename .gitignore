# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/

# Tool output (regenerated per-game)
tools/disasm/output/
tools/func_id/output/
tools/recomp/output/
tools/abi_analysis/output/

# Game files (user provides their own)
game_files/
*.xbe
*.iso
*.xiso

# IDE
.vs/
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
.DS_Store

# Build
build/
bin/
*.obj
*.exe
tools/split/output/

# Built from launcher/icon/AppIcon.iconset by launcher/build_app.sh
launcher/AppIcon.icns

# Builds of the game (see port/CMakeLists.txt) and packaged apps
/build*/
*.app/
*.tar.gz
*.zip
*.ipa

# The generated code: derived from the game's executable, never committed
port/recomp/

# The game's files, saves and logs, wherever a run puts them (the Linux
# launcher's portable/ folder holds all three)
Media/
UDATA/
TDATA/
portable/
Partition*.img
*.log
*.dump

# Backups and merge leftovers
*.bak*
*.orig
