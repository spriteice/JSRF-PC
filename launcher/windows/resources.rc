/* Icon, manifest and version information for the launcher and the engine.
 * Built twice: -DJSRF_ENGINE for engine\jsrf_recomp.exe. jsrf_version.h is
 * written by the build (JSRF_VER_NUM, four comma-separated numbers, and
 * JSRF_VER_STR): a string passed with -D does not survive the resource
 * compiler's command line. */
#include <winver.h>
#include "jsrf_version.h"

1 ICON "jsrf.ico"

#ifdef JSRF_ENGINE
1 24 "engine.manifest"
#define JSRF_DESC "JSRF-PC engine"
#define JSRF_FILE "jsrf_recomp.exe"
#else
1 24 "launcher.manifest"
#define JSRF_DESC "JSRF-PC"
#define JSRF_FILE "JSRF-PC.exe"
#endif

1 VERSIONINFO
FILEVERSION JSRF_VER_NUM
PRODUCTVERSION JSRF_VER_NUM
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", JSRF_DESC
      VALUE "ProductName", "JSRF-PC"
      VALUE "FileVersion", JSRF_VER_STR
      VALUE "ProductVersion", JSRF_VER_STR
      VALUE "OriginalFilename", JSRF_FILE
      VALUE "Comments", "Jet Set Radio Future, statically recompiled. An unofficial fan project, not affiliated with SEGA."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
