#!/bin/bash
#
# JSRF-PC -- the Linux launcher.
#
# Finds your copy of Jet Set Radio Future (the folder with default.xbe in it),
# remembers it, and starts the game with the settings it needs.
#
#   ./jsrf-pc                  play (asks where the game is, the first time)
#   ./jsrf-pc /path/to/game    use that folder (or a disc image -- see below), and remember it
#   ./jsrf-pc --choose         ask where the game is again
#   ./jsrf-pc --scale N        internal resolution, 1 to 4 times 640x480 (default 2); remembered
#   ./jsrf-pc --fullscreen     start full screen
#   ./jsrf-pc --install        add JSRF-PC to your applications menu
#   ./jsrf-pc --version        which version this is
#
# A disc image (.iso) is unpacked once, by the game itself: nothing else to install.
# Portable: with a folder named "portable" beside this script, the settings,
# saves, and logs are kept in it, and nothing in your home folder.
# In game: F1 the in-game menu, F11 (or Alt+Return) full screen, F10 widescreen
# 16:9, F9 resolution, and F8 the free camera.
#
set -u
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Looked for first, before anything is read or made: in portable mode nothing
# outside this folder is touched but the game's own files.
if [ -d "$HERE/portable" ]; then
    PORTABLE="$HERE/portable"
    CFG="$PORTABLE/settings.cfg"
    DATA="$PORTABLE/games"
    SAVE="$PORTABLE/cache"
    STATE="$PORTABLE/logs"
    LOGS="$STATE"
else
    PORTABLE=""
    CFG="${XDG_CONFIG_HOME:-$HOME/.config}/jsrf-pc/settings"
    DATA="${XDG_DATA_HOME:-$HOME/.local/share}/jsrf-pc"
    SAVE="$DATA/save"
    STATE="${XDG_STATE_HOME:-$HOME/.local/state}/jsrf-pc"
    LOGS="$STATE/logs"
fi

cfg_get() { [ -f "$CFG" ] && sed -n "s/^$1=//p" "$CFG" | tail -n 1; }
cfg_set() {   # key value: replace or append, keeping every other line
    local tmp="$CFG.tmp"
    { [ -f "$CFG" ] && grep -v "^$1=" "$CFG"; printf '%s=%s\n' "$1" "$2"; } > "$tmp" && mv "$tmp" "$CFG"
}

# A message the player can see: a dialog when there is a desktop to show one.
say() {
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
        zenity --info --no-wrap --title="JSRF-PC" --text="$1" 2>/dev/null
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v kdialog >/dev/null 2>&1; then
        kdialog --title "JSRF-PC" --msgbox "$1" 2>/dev/null
    else
        printf '%s\n' "$1" >&2
    fi
}
fail() { say "$1"; exit 1; }

mkdir -p "${CFG%/*}" "$SAVE" "$LOGS" ${PORTABLE:+"$PORTABLE/saves"}
# A portable folder that cannot be written stops here rather than falling back
# to the home folder, which would split the saves between two places.
[ -z "$PORTABLE" ] || [ -w "$PORTABLE" ] || \
    fail "$(printf "The portable folder can't be written to:\n\n%s\n\nMake it writable, or remove it to keep the settings, saves and logs in your home folder instead." "$PORTABLE" | fold -s -w 72)"

is_game() { [ -n "$1" ] && [ -f "$1/default.xbe" ] && [ -d "$1/Media" ]; }

ask_game() {
    local q="Where is Jet Set Radio Future? Pick the folder that contains default.xbe, or the folder your disc image (.iso) is in."
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
        zenity --file-selection --directory --title="$q" 2>/dev/null
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v kdialog >/dev/null 2>&1; then
        kdialog --getexistingdirectory "$HOME" --title "$q" 2>/dev/null
    elif [ -t 0 ]; then
        printf '%s\nFolder: ' "$q" >&2
        local d; IFS= read -r d; printf '%s' "$d"
    fi
}

engine() { LD_LIBRARY_PATH="$HERE/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "$HERE/bin/jsrf_recomp" "$@"; }

# Files that are not the game JSRF-PC runs: say what they are (the
# engine's own check, port/xbe_check.c, names them) and forget them.
refuse() {
    cfg_set game_dir ""
    fail "$(printf "These files won't work with JSRF-PC.\n\n%s\n" "$1" | fold -s -w 72)"
}

# The engine's output while it unpacks, line by line as it comes (awk would
# hold it back in a buffer): its progress lines for zenity ("# text" first and
# the percentage last -- zenity closes on 100) or the terminal; everything else,
# its answer, into $STATE/unpack.out.
relay() {
    local mode="$1" name="$2" line d t
    while IFS= read -r line; do
        case "$line" in
            "progress "*)
                set -- $line; d="$2"; t="$3"
                [ "$t" -gt 0 ] 2>/dev/null || continue
                if [ "$mode" = zenity ]; then
                    printf '# Unpacking %s -- %d.%d of %d.%d GB\n%d\n' "$name" \
                        $((d / 1000000000)) $((d / 100000000 % 10)) \
                        $((t / 1000000000)) $((t / 100000000 % 10)) $((d * 100 / t))
                else
                    printf '\r  %d.%d of %d.%d GB' $((d / 1000000000)) $((d / 100000000 % 10)) \
                        $((t / 1000000000)) $((t / 100000000 % 10)) >&2
                fi ;;
            *) printf '%s\n' "$line" >> "$STATE/unpack.out" ;;
        esac
    done
}

# A disc image: unpacked once into ~/.local/share/jsrf-pc/<name> (in
# portable mode, portable/games/<name>), by the engine (--unpack-iso: the
# unpacker the other apps use, port/ios/xiso.c), so nothing else has to be
# installed. Checked first, so a zip, another game's
# disc or another build of the game is named before anything is unpacked.
# Prints the game folder; nothing if unpacking was cancelled.
from_iso() {
    local iso="$1" name dest why ps
    name="$(basename "$iso")"; name="${name%.*}"; name="${name%.xiso}"
    dest="$DATA/$name"
    if is_game "$dest"; then printf '%s' "$dest"; return; fi
    why="$(engine --check-iso "$iso" 2>/dev/null)"
    case $? in 0) ;; 2|3|4) refuse "$why" ;; *) fail "Could not read $iso." ;; esac
    rm -rf -- "${dest:?}"
    : > "$STATE/unpack.out"
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
        engine --unpack-iso "$iso" "$dest" 2>/dev/null | relay zenity "$(basename "$iso")" \
            | zenity --progress --title="JSRF-PC" --auto-close \
                     --text="Unpacking $(basename "$iso") -- this happens once." 2>/dev/null
        ps=("${PIPESTATUS[@]}")
        if [ "${ps[2]}" -ne 0 ] && ! grep -qx ok "$STATE/unpack.out"; then   # Cancel
            rm -rf -- "${dest:?}"
            return 0
        fi
    else
        printf 'Unpacking %s -- this happens once. The files go to:\n  %s\n' "$(basename "$iso")" "$dest" >&2
        engine --unpack-iso "$iso" "$dest" 2>/dev/null | relay terminal "$(basename "$iso")"
        ps=("${PIPESTATUS[@]}")
        printf '\n' >&2
    fi
    why="$(grep -vx ok "$STATE/unpack.out")"
    if [ "${ps[0]}" -ne 0 ] || ! is_game "$dest"; then
        rm -rf -- "${dest:?}"
        case "${ps[0]}" in 2|3|4) refuse "$why" ;; esac
        fail "$(printf "The disc image could not be unpacked.\n\n%s\n" "${why:-(exit ${ps[0]})}" | fold -s -w 72)"
    fi
    printf '%s' "$dest"
}

# What was given or picked -> the game folder: the folder itself, the folder
# of a default.xbe, a disc image (any file: the engine says what it is if it
# is not one), or a folder with one disc image in it.
pick() {
    local p="$1" imgs
    if [ -f "$p" ]; then
        case "$(basename "$p")" in
            [Dd][Ee][Ff][Aa][Uu][Ll][Tt].[Xx][Bb][Ee]) p="$(dirname "$p")" ;;
            *) from_iso "$p"; return ;;
        esac
    fi
    if [ -d "$p" ] && ! is_game "$p"; then
        mapfile -t imgs < <(find "$p" -maxdepth 1 -type f \( -iname '*.iso' -o -iname '*.xiso' \) 2>/dev/null | sort)
        if [ "${#imgs[@]}" -eq 1 ]; then from_iso "${imgs[0]}"; return; fi
        [ "${#imgs[@]}" -gt 1 ] && fail "That folder has ${#imgs[@]} disc images in it: give the one of Jet Set Radio Future."
    fi
    printf '%s' "$p"
}

install_desktop() {
    # The menu is in the home folder, which portable mode leaves alone.
    [ -z "$PORTABLE" ] || fail "$(printf "JSRF-PC is in portable mode (it has a \"portable\" folder), so it does not add itself to the applications menu, which is kept in your home folder." | fold -s -w 72)"
    local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    mkdir -p "$apps"
    cat > "$apps/jsrf-pc.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=JSRF-PC
Comment=Jet Set Radio Future, running natively
Exec="$HERE/jsrf-pc"
Icon=$HERE/share/jsrf-pc.png
Terminal=false
Categories=Game;
EOF
    echo "Added JSRF-PC to your applications menu ($apps/jsrf-pc.desktop)."
}

GAME=""; CHOOSE=0; FULLSCREEN=0
while [ $# -gt 0 ]; do
    case "$1" in
        --choose)     CHOOSE=1 ;;
        --scale)      shift
                      case "${1:-}" in [1-4]) cfg_set scale "$1" ;;
                                       *) fail "--scale takes 1, 2, 3 or 4." ;; esac ;;
        --fullscreen) FULLSCREEN=1 ;;
        --install)    install_desktop; exit 0 ;;
        --version)    cat "$HERE/VERSION" 2>/dev/null || "$HERE/bin/jsrf_recomp" --version; exit 0 ;;
        -h|--help)    sed -n '4,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)            GAME="$1" ;;
    esac
    shift
done

# Portable: a game folder inside this one is remembered relative to it, so the
# whole folder can move (another path, an SD card) and still find it.
LAST_GAME="$(cfg_get game_dir)"
[ -n "$PORTABLE" ] && case "$LAST_GAME" in /*|"") ;; *) LAST_GAME="$HERE/$LAST_GAME" ;; esac

# Which game folder: the argument, else the remembered one, else ask.
if [ -n "$GAME" ]; then
    GAME="$(pick "$GAME")" || exit 1
elif [ "$CHOOSE" = 0 ] && is_game "$LAST_GAME"; then
    GAME="$LAST_GAME"
else
    GAME="$(ask_game)"
    [ -n "$GAME" ] || exit 0
    GAME="$(pick "$GAME")" || exit 1
fi
[ -n "$GAME" ] || exit 0          # unpacking was cancelled
GAME="$(cd "$GAME" 2>/dev/null && pwd)" || fail "That folder does not exist."
is_game "$GAME" || fail "$(printf "That folder has no default.xbe and Media in it, so it isn't the game's files. Pick the folder you extracted the game into, or your disc image (.iso)." | fold -s -w 72)"

# The engine is the standalone US disc's program, translated address for
# address: another build (European, Japanese, a Sega GT 2002 combo disc)
# starts and then crashes a few seconds in. Its own check (port/xbe_check.c)
# says what the files are; exit 3 = another build or another game.
why="$(engine --check-game "$GAME" 2>/dev/null)"
case $? in 2|3) refuse "$why" ;; esac
KEEP="$GAME"
[ -n "$PORTABLE" ] && case "$GAME" in "$HERE"/*) KEEP="${GAME#"$HERE"/}" ;; esac
cfg_set game_dir "$KEEP"

# Portable: the saves the game kept in its own folder (UDATA, TDATA) are
# copied into portable/saves the first time, so its progress carries over.
# Copied, not moved: the originals stay where they were.
if [ -n "$PORTABLE" ]; then
    for d in UDATA TDATA; do
        [ -d "$GAME/$d" ] && [ ! -e "$PORTABLE/saves/$d" ] || continue
        cp -R "$GAME/$d" "$PORTABLE/saves/" || {
            rm -rf -- "${PORTABLE:?}/saves/$d"
            fail "$(printf "The saves in\n%s\ncould not be copied into\n%s\nso the game was not started. The originals are untouched." "$GAME/$d" "$PORTABLE/saves" | fold -s -w 72)"
        }
    done
fi

SCALE="$(cfg_get scale)"; case "$SCALE" in [1-4]) ;; *) SCALE=2 ;; esac

# The previous run's log is kept (five of them), then a fresh one.
LOG="$STATE/last-run.log"
if [ -f "$LOG" ]; then
    mv "$LOG" "$LOGS/run-$(date +%Y%m%d-%H%M%S).log"
    ls -1t "$LOGS"/run-*.log 2>/dev/null | tail -n +6 | while IFS= read -r old; do rm -f "$old"; done
fi

export RECOMP_USB=1 RECOMP_GL=1 RECOMP_PB_EXEC=1 RECOMP_VBLANK=1 RECOMP_AC97_READY_NOTRAP=1 \
       RECOMP_TRACE_BUDGET=0 RECOMP_GL_READBACK=0 RECOMP_FPS=60 RECOMP_ABI_RESTORE=1 \
       RECOMP_LOCK_IDLE=1 RECOMP_GL_CURTAIN=skip RECOMP_MUTE=0 RECOMP_WINDOW=1
export RECOMP_GL_SCALE="$SCALE"
[ "$FULLSCREEN" = 1 ] && export RECOMP_FULLSCREEN=1
export JSRF_GAME_DIR="$GAME" JSRF_SAVE_DIR="$SAVE" JSRF_SETTINGS_FILE="$CFG"
# Portable: the game's saves go to portable/saves, not the game folder (the
# engine's path layer, src/kernel/kernel_path.c).
[ -n "$PORTABLE" ] && export JSRF_USER_DIR="$PORTABLE/saves"
export LD_LIBRARY_PATH="$HERE/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# What the engine writes by a relative name (xbox_kernel.log, the icall dumps)
# goes to the game folder, or to the logs in portable mode.
WORK="$GAME"; [ -n "$PORTABLE" ] && WORK="$LOGS"
cd "$WORK" || exit 1
"$HERE/bin/jsrf_recomp" "$GAME" > "$LOG" 2>&1
status=$?
if [ "$status" -eq 3 ]; then
    # The engine's own check stopped it: not the standalone US disc's files
    # (the log says what they are).
    cfg_set game_dir ""
    say "$(printf "These files won't work with JSRF-PC.\n\n%s\n" \
              "$(sed -n 's/^\[XBE\] //p' "$LOG")" | fold -s -w 72)"
elif [ "$status" -ne 0 ]; then
    say "JSRF-PC stopped unexpectedly (exit $status).

The log is at:
$LOG

If you report the problem, please attach it."
fi
exit "$status"
